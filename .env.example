# Salin file ini ke .env.local dan sesuaikan nilainya.
# Jangan commit file .env.local ke git.

# Setel ke 'true' untuk menjalankan build statis export (next export).
EXPORT=

# Setel ke 'true' untuk mengaktifkan bundle analyzer saat build.
ANALYZE=

# Node environment (development | production)
NODE_ENV=development

# === Prismic CMS ===

# Nama repository Prismic (bagian sebelum .prismic.io)
PRISMIC_REPOSITORY_NAME=

# Permanent token (Settings → API & Security). Dipakai server-side saat build
# dan oleh script migrasi. Jangan pernah di-commit.
PRISMIC_ACCESS_TOKEN=

# Kode locale master di Prismic (lihat Settings → Languages), mis. id
PRISMIC_LANG=id
